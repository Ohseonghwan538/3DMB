<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.map.egis.festival.mapper.FestivalTypeMapper">
  <resultMap id="festivalType" type="com.map.egis.festival.dto.FestivalTypeDto">
    <constructor>
      <idArg column="type_code" javaType="string"/>
      <arg column="type_name" javaType="string"/>
      <arg column="marker_image" javaType="string"/>
    </constructor>
  </resultMap>
  <select id="findAll" resultMap="festivalType">
    SELECT type_code, type_name, marker_image
      FROM festival_type
     ORDER BY sort_order, type_code
  </select>
  <select id="findRegions" resultType="string">
    SELECT DISTINCT sido FROM festival WHERE sido IS NOT NULL AND sido &lt;&gt; ''
     ORDER BY sido
  </select>
</mapper>
